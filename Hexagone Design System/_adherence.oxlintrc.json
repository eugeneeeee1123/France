{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/content/**",
              "components/data/**",
              "components/editorial/**",
              "components/icons/**",
              "components/navigation/**",
              "image-slot.js",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|Public Sans|IBM Plex Mono|Noto Serif SC|Noto Sans SC))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, Public Sans, IBM Plex Mono, Noto Serif SC, Noto Sans SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|icon|iconPosition|disabled|onClick|href|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, icon, iconPosition, disabled, onClick, href, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|ghost)$/]",
        "message": "<Button> variant must be one of 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:start|end)$/]",
        "message": "<Button> iconPosition must be one of 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onClick|size|uppercase|arrow|style|key|ref|className|style|children)$/]",
        "message": "<CtaLink> doesn't accept that prop. Declared props: children, href, onClick, size, uppercase, arrow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|size|accentWord|reveal|style|key|ref|className|style|children)$/]",
        "message": "<DisplayTitle> doesn't accept that prop. Declared props: children, as, size, accentWord, reveal, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|div)$/]",
        "message": "<DisplayTitle> as must be one of 'h1' | 'h2' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|grandeur)$/]",
        "message": "<DisplayTitle> size must be one of 'hero' | 'grandeur'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HexMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|letter|withWordmark|wordmark|filled|style|key|ref|className|style|children)$/]",
        "message": "<HexMark> doesn't accept that prop. Declared props: size, tone, letter, withWordmark, wordmark, filled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HexMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|paper)$/]",
        "message": "<HexMark> tone must be one of 'gold' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|variant|style|key|ref|className|style|children)$/]",
        "message": "<LangSwitch> doesn't accept that prop. Declared props: value, onChange, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangSwitch'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:fr|en|zh)$/]",
        "message": "<LangSwitch> value must be one of 'fr' | 'en' | 'zh'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangSwitch'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:inline|menu)$/]",
        "message": "<LangSwitch> variant must be one of 'inline' | 'menu'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModuleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|name|hue|bullets|imageSrc|imageSlotId|imagePlaceholder|active|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ModuleCard> doesn't accept that prop. Declared props: n, name, hue, bullets, imageSrc, imageSlotId, imagePlaceholder, active, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModuleHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|title|subtitle|intro|hue|children|style|key|ref|className|style|children)$/]",
        "message": "<ModuleHeader> doesn't accept that prop. Declared props: n, title, subtitle, intro, hue, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavModule'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|n|name|hue|key|ref|className|style|children)$/]",
        "message": "<NavModule> doesn't accept that prop. Declared props: key, n, name, hue."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|attribution|variant|imageSrc|imageSlotId|style|key|ref|className|style|children)$/]",
        "message": "<QuoteBlock> doesn't accept that prop. Declared props: quote, attribution, variant, imageSrc, imageSlotId, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:card|panel)$/]",
        "message": "<QuoteBlock> variant must be one of 'card' | 'panel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RelatedLinks'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|links|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<RelatedLinks> doesn't accept that prop. Declared props: label, links, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScenarioLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<ScenarioLabel> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionEyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|style|key|ref|className|style|children)$/]",
        "message": "<SectionEyebrow> doesn't accept that prop. Declared props: children, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionEyebrow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:centered|lead)$/]",
        "message": "<SectionEyebrow> variant must be one of 'centered' | 'lead'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:tagline|navLabel|navLinks|socialLabel|langLabel|lang|onLangChange|legal|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: tagline, navLabel, navLinks, socialLabel, langLabel, lang, onLangChange, legal, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:fr|en|zh)$/]",
        "message": "<SiteFooter> lang must be one of 'fr' | 'en' | 'zh'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|variant|style|key|ref|className|style|children)$/]",
        "message": "<StatStrip> doesn't accept that prop. Declared props: items, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatStrip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:open|boxed)$/]",
        "message": "<StatStrip> variant must be one of 'open' | 'boxed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Timeline'] > JSXAttribute > JSXIdentifier[name!=/^(?:eras|activeIndex|defaultActiveIndex|onSelect|bordered|style|key|ref|className|style|children)$/]",
        "message": "<Timeline> doesn't accept that prop. Declared props: eras, activeIndex, defaultActiveIndex, onSelect, bordered, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TricolorRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|gap|palette|style|key|ref|className|style|children)$/]",
        "message": "<TricolorRule> doesn't accept that prop. Declared props: width, height, gap, palette, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TricolorRule'] > JSXAttribute[name.name='palette'] > Literal[value!=/^(?:muted|brief)$/]",
        "message": "<TricolorRule> palette must be one of 'muted' | 'brief'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhyHowWhat'] > JSXAttribute > JSXIdentifier[name!=/^(?:why|how|what|hue|lang|labels|style|key|ref|className|style|children)$/]",
        "message": "<WhyHowWhat> doesn't accept that prop. Declared props: why, how, what, hue, lang, labels, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhyHowWhat'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:fr|en|zh)$/]",
        "message": "<WhyHowWhat> lang must be one of 'fr' | 'en' | 'zh'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
